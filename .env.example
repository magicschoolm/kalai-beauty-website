# Copy this file to ".env" and fill in the real value.
# Vite only exposes variables that start with VITE_ to the site code.
#
# The public web address of the site. Used for share/canonical links.
# Leave it empty or delete the file and the site still works - it just
# omits those tags (we never invent a placeholder domain).
#
# VITE_SITE_URL=https://yourdomain.com
